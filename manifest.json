{
  "manifest_version": 2,
  "name": "Host Jumper",
  "description": "Jump to configured paths on the current host with placeholder substitution.",
  "version": "0.1.1",
  "icons": {
    "64": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "background": {
    "scripts": [
      "shared.js",
      "background_script.js"
    ]
  },
  "browser_action": {
    "default_icon": {
      "64": "icons/icon.svg"
    },
    "default_title": "Host Jumper"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "open-host-jumper": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Open Host Jumper picker"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "host-jumper@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
